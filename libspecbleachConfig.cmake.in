@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Public dependencies: libspecbleach has no public CMake dependencies.
# If any public dependencies are added in the future, find_dependency() calls go here.

include("${CMAKE_CURRENT_LIST_DIR}/libspecbleachTargets.cmake")

# Optional extras component: find_package(libspecbleach COMPONENTS extras)
if("extras" IN_LIST libspecbleach_FIND_COMPONENTS)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/libspecbleachExtrasTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/libspecbleachExtrasTargets.cmake")
    set(libspecbleach_extras_FOUND TRUE)
  else()
    set(libspecbleach_extras_FOUND FALSE)
  endif()
endif()

check_required_components(libspecbleach)
